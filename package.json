{
  "name": "city-hub",
  "private": true,
  "version": "0.9.4",
  "license": "MIT",
  "description": "Open civic intelligence and planning tool. Models a city as systems with capacity and demand, over live air, water, traffic, satellite and civic-report feeds. Every number declares whether it is measured, derived or assumed.",
  "homepage": "https://hub.nonarkara.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nonarkara/city-hub.git"
  },
  "bugs": {
    "url": "https://github.com/Nonarkara/city-hub/issues"
  },
  "keywords": [
    "civic-tech",
    "open-data",
    "smart-city",
    "urban-analytics",
    "gis",
    "maplibre",
    "satellite",
    "air-quality",
    "bangkok",
    "openstreetmap"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:list": "playwright test --list"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tz-lookup": "^6.1.25",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  }
}
