# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore.

# Mapbox public token — https://account.mapbox.com/access-tokens
# Use a pk.* token, URL-restricted to *.pages.dev and *.nonarkara.org.
VITE_MAPBOX_ACCESS_TOKEN=

# Cloudflare Worker proxy for CORS-blocked APIs
VITE_PROXY_URL=

# Optional — WAQI token for global air quality sensor network
# VITE_WAQI_TOKEN=your-waqi-token

# Optional — Longdo Thai basemap key
# VITE_LONGDO_KEY=your-longdo-key

# Optional — TomTom Traffic API key (2,500 free requests/day)
# VITE_TOMTOM_KEY=your-tomtom-key

# Optional — OpenWeatherMap One Call API 3.0 key
# VITE_OPENWEATHERMAP_KEY=your-owm-key

# Optional — OpenAQ API v3 key
# VITE_OPENAQ_KEY=your-openaq-key

# Optional — NASA FIRMS MAP_KEY for live fire data (free registration):
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Production uses the Worker's FIRMS_MAP_KEY secret instead — this is only
# needed for direct (unproxied) dev calls.
# VITE_FIRMS_MAP_KEY=your-firms-map-key

# Optional — Supabase backend for longitudinal data caching
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — local Ollama chatbot (the ASK button). Defaults below.
# Runs on YOUR machine; nothing leaves it. Install: https://ollama.com
#   ollama pull qwen2.5-coder:1.5b && ollama serve
# For the DEPLOYED site to reach your local Ollama, allow the origin:
#   OLLAMA_ORIGINS="https://city-hub.pages.dev" ollama serve
# VITE_OLLAMA_URL=http://localhost:11434
# VITE_OLLAMA_MODEL=qwen2.5-coder:1.5b

# Optional — cloud chatbot (the ASK "CLOUD" toggle) via Firebase AI Logic.
# Firebase config lives in src/lib/firebase.ts. Enable it once at:
#   Firebase console → Build → AI Logic → Gemini Developer API
# VITE_GEMINI_MODEL=gemini-2.5-flash
