# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore.

# Mapbox public token — https://account.mapbox.com/access-tokens
# Use a pk.* token, URL-restricted to *.pages.dev and *.nonarkara.org.
VITE_MAPBOX_ACCESS_TOKEN=

# Cloudflare Worker proxy for CORS-blocked APIs
VITE_PROXY_URL=

# Optional — WAQI token for global air quality sensor network
# VITE_WAQI_TOKEN=your-waqi-token

# Optional — Longdo Thai basemap key
# VITE_LONGDO_KEY=your-longdo-key

# Optional — TomTom Traffic API key (2,500 free requests/day)
# VITE_TOMTOM_KEY=your-tomtom-key

# Optional — OpenWeatherMap One Call API 3.0 key
# VITE_OPENWEATHERMAP_KEY=your-owm-key

# Optional — OpenAQ API v3 key
# VITE_OPENAQ_KEY=your-openaq-key

# Optional — Supabase backend for longitudinal data caching
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
