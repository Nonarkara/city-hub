# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is in .gitignore.

# UNL Platform credentials — https://platform.unl.global/developer_portal
VITE_UNL_API_KEY=
VITE_UNL_VPM_ID=

# Cloudflare Worker proxy for CORS-blocked APIs
VITE_PROXY_URL=

# Optional — WAQI token for global air quality sensor network
# VITE_WAQI_TOKEN=your-waqi-token

# Optional — Longdo Thai basemap key
# VITE_LONGDO_KEY=your-longdo-key

# Optional — TomTom Traffic API key (2,500 free requests/day)
# VITE_TOMTOM_KEY=your-tomtom-key

# Optional — Supabase backend for longitudinal data caching
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
